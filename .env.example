# Environment
ENVIRONMENT=development
PROJECT_NAME="Autonomous Inventory Management System"
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL primary with SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./inventory.db
SYNC_DATABASE_URL=sqlite:///./inventory.db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_db

# Redis Configuration (Cache, Locks & Celery Broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & Authentication
JWT_SECRET_KEY=super-secret-development-jwt-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Shopify Webhook Signature Verification Secret
SHOPIFY_WEBHOOK_SECRET=shpss_example_secret_for_hmac_sha256_verification

# Supplier Gateway & Notifications
SUPPLIER_MOCK_API_URL=http://localhost:8000/api/v1/suppliers/mock-endpoint
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASSWORD=mock_pass
SMTP_FROM_EMAIL=procurement@autonomous-inventory.local
SLACK_WEBHOOK_URL=

# MLflow Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=demand_forecasting

# Storage Path for PO PDFs
STORAGE_DIR=./storage
PO_PDF_DIR=./storage/purchase_orders


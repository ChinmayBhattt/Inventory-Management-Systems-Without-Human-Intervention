{
  "name": "inventory-management",
  "version": "1.0.0",
  "description": "Pure software-based Autonomous Inventory Management System",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "lint": "npm --prefix frontend run lint",
    "backend": "./bin/server",
    "backend:dev": "go run ./backend_go/cmd/server",
    "backend:build": "go build -o bin/server ./backend_go/cmd/server"
  },
  "keywords": [
    "inventory",
    "autonomous",
    "supply-chain",
    "fastapi",
    "nextjs"
  ],
